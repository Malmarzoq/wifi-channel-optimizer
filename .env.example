# انسخ هذا الملف إلى .env ثم ضع بيانات الراوتر الفعلية محليًا.
# لا ترفع ملف .env إلى GitHub.

ROUTER_IP=192.168.1.1
ROUTER_USER=your_router_username
ROUTER_PASS=your_router_password
# SSH service port. Use 22 unless your router is configured differently.
SSH_PORT=22
# 2.4 GHz interface name; it varies by model and firmware. `eth6` is a tested ASUS example.
WIFI_IFACE=eth6
# Optional: a dedicated known_hosts file. Leave empty to use ~/.ssh/known_hosts.
SSH_KNOWN_HOSTS=
NVRAM_RADIO=wl0
# Keep this enabled while validating a new router configuration.
# Set to false only when you are ready to allow channel changes.
DRY_RUN=true
